android/key.properties
**/*.keystore
**/*.jks

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Project-specific
reference/
memory.md
.claude/

# Exceptions to above rules.
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages
